# Copy this file to deploy/.env for local use. Never commit deploy/.env.
MYSQL_ROOT_PASSWORD=1234
MYSQL_HOST_PORT=13306
ELASTICSEARCH_HOST_PORT=19200
TJ_JDBC_USERNAME=root
TJ_JDBC_PASSWORD=1234
TJ_KEYSTORE_PASSWORD=changeit
TJ_KEYSTORE_SECRET=changeit
RABBITMQ_DEFAULT_USER=tjxt
RABBITMQ_DEFAULT_PASS=123321
RABBITMQ_DEFAULT_VHOST=/tjxt

# Java services use these defaults when they run on the host. The service
# Compose overlay replaces them with Docker service names automatically.
SPRING_PROFILES_ACTIVE=local
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=
TJ_JDBC_HOST=localhost
TJ_REDIS_HOST=localhost
TJ_MQ_HOST=localhost
ELASTICSEARCH_URIS=http://localhost:9200

# Optional integrations. Leave empty for the local infrastructure-only demo.
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
ALI_SMS_ACCESS_ID=
ALI_SMS_ACCESS_SECRET=
ALI_PAY_APP_ID=
ALI_PAY_MERCHANT_PRIVATE_KEY=
ALI_PAY_PUBLIC_KEY=
WX_PAY_APP_ID=
WX_PAY_MCH_ID=
WX_PAY_MCH_SERIAL_NO=
WX_PAY_PRIVATE_KEY=
WX_PAY_API_V3_KEY=
