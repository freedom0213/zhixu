# Copy this file to deploy/.env for local use. Never commit deploy/.env.
MYSQL_ROOT_PASSWORD=1234
MYSQL_HOST_PORT=13306
ELASTICSEARCH_HOST_PORT=19200
TJ_JDBC_USERNAME=root
TJ_JDBC_PASSWORD=1234
TJ_KEYSTORE_PASSWORD=changeit
TJ_KEYSTORE_SECRET=changeit
RABBITMQ_DEFAULT_USER=tjxt
RABBITMQ_DEFAULT_PASS=123321
RABBITMQ_DEFAULT_VHOST=/tjxt

# Java services use these defaults when they run on the host. The service
# Compose overlay replaces them with Docker service names automatically.
SPRING_PROFILES_ACTIVE=local
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=
TJ_JDBC_HOST=localhost
TJ_REDIS_HOST=localhost
TJ_MQ_HOST=localhost
ELASTICSEARCH_URIS=http://localhost:9200

# Optional integrations. Leave empty for the local infrastructure-only demo.
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
ALI_SMS_ACCESS_ID=
ALI_SMS_ACCESS_SECRET=
ALI_PAY_APP_ID=
ALI_PAY_MERCHANT_PRIVATE_KEY=
ALI_PAY_PUBLIC_KEY=
WX_PAY_APP_ID=
WX_PAY_MCH_ID=
WX_PAY_MCH_SERIAL_NO=
WX_PAY_PRIVATE_KEY=
WX_PAY_API_V3_KEY=

# --- AI / Vector store (optional, leave empty for local keyword fallback) ---
# DeepSeek API key for chat + (optionally) embedding.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Embedding model name. Leave empty to disable embedding/vector retrieval.
# Examples: text-embedding-3-small (1536), text-embedding-3-large (3072),
# or DeepSeek's text-embedding model (check the dimension).
TJ_AI_EMBEDDING_MODEL=
# Override embedding endpoint if it differs from chat (e.g. SiliconFlow).
TJ_AI_EMBEDDING_BASE_URL=
# Separate API key for the embedding provider; leave empty to reuse DEEPSEEK_API_KEY.
TJ_AI_EMBEDDING_API_KEY=
TJ_AI_EMBEDDING_DIMENSION=1536
# Toggle the pgvector persistence layer. true = write vectors to Postgres,
# false = stay on the in-memory chunks.json fallback.
TJ_AI_VECTOR_STORE_ENABLED=true
# Postgres (pgvector) connection. Defaults match deploy/docker-compose.yml.
TJ_PG_HOST=localhost
TJ_PG_PORT=5433
TJ_PG_DATABASE=tianji
TJ_PG_USER=tianji
TJ_PG_PASSWORD=tianji123

# Rerank (optional, leave empty to disable — falls back to vector topK straight to LLM).
# Common models: BAAI/bge-reranker-v2-m3 (SiliconFlow), jina-rerank-v2-base-multilingual.
TJ_AI_RERANK_MODEL=
TJ_AI_RERANK_BASE_URL=
TJ_AI_RERANK_API_KEY=
TJ_AI_RERANK_CANDIDATE_K=10
TJ_AI_RERANK_TOP_N=3
